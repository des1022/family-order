<!-- 菜品行卡片：大图 + 名称/描述/价格 + 右侧加号 -->
<view class="dish-row">
  <image
    class="dish-img"
    src="{{dish.image}}"
    mode="aspectFill"
    lazy-load="{{true}}"
    bindtap="onPreview"
  />

  <view class="dish-main">
    <view class="dish-name">{{dish.name}}</view>
    <view class="dish-desc" wx:if="{{dish.desc}}">{{dish.desc}}</view>
    <view class="dish-foot">
      <text class="dish-price" wx:if="{{dish.price > 0}}">¥{{dish.priceText}}</text>
      <text class="dish-price dish-price--none" wx:else>时价</text>
    </view>
  </view>

  <view class="add-btn" bindtap="onAdd" hover-class="add-btn--hover">
    <text class="add-plus">＋</text>
  </view>
</view>
