.dish-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.dish-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-foot {
  margin-top: auto;
  padding-top: 10rpx;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
}

.dish-price--none {
  font-size: 26rpx;
  font-weight: 400;
  color: #B4B9C0;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FF7A45;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 69, 0.35);
}

.add-btn--hover {
  background: #E85F2B;
  transform: scale(0.92);
}

.add-plus {
  color: #fff;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -4rpx;
}
