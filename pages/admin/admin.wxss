/* ===== 密码锁 ===== */
.lock {
  min-height: 100vh;
  background: #F6F7F9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.lock-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 40rpx 40rpx;
}

.lock-title {
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
  color: #1F2329;
}

.lock-sub {
  font-size: 26rpx;
  color: #8A9099;
  text-align: center;
  margin-top: 12rpx;
}

.pwd-box {
  display: flex;
  justify-content: center;
  margin: 48rpx 0 16rpx;
}

.pwd-cell {
  width: 96rpx;
  height: 96rpx;
  margin: 0 14rpx;
  border: 2rpx solid #E5E6EB;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1F2329;
  background: #FAFBFC;
}

.pwd-cell--on {
  border-color: #FF7A45;
  background: #FFF3ED;
}

.lock-err {
  text-align: center;
  font-size: 26rpx;
  color: #F5222D;
  min-height: 40rpx;
}

.keypad {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.key {
  width: 33.33%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1F2329;
  border-top: 2rpx solid #F0F1F3;
  border-right: 2rpx solid #F0F1F3;
}

.key:nth-child(3n) {
  border-right: none;
}

.key:active {
  background: #F2F3F5;
}

.key--fn {
  font-size: 30rpx;
  color: #4E5969;
}

.lock-tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #B4B9C0;
  text-align: center;
  line-height: 1.6;
}

/* ===== 管理主页 ===== */
.page {
  padding-bottom: 220rpx;
}

.entry-bar {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  min-height: 104rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-title {
  font-size: 30rpx;
  color: #1F2329;
}

.entry-arrow {
  font-size: 40rpx;
  color: #C9CDD4;
  line-height: 1;
}

.filter-bar {
  background: #fff;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0F1F3;
}

.filter-inner {
  display: inline-flex;
  padding: 0 24rpx;
}

.filter-item {
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #4E5969;
  background: #F2F3F5;
  white-space: nowrap;
}

.filter-item--active {
  background: #FFF3ED;
  color: #FF7A45;
  font-weight: 600;
}

.group-title {
  padding: 28rpx 32rpx 8rpx;
  font-size: 28rpx;
  color: #8A9099;
}

.group-count {
  color: #B4B9C0;
}

.dish-card {
  display: block;
  padding: 20rpx;
  margin: 20rpx 24rpx;
}

.dish-img {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
}

.dish-main {
  margin-top: 16rpx;
}

.dish-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
}

.dish-desc {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 8rpx;
}

.dish-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF7A45;
  margin-top: 8rpx;
}

.dish-price--none {
  font-size: 26rpx;
  font-weight: 400;
  color: #B4B9C0;
}

.dish-ops {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F5F6F7;
}

.op-btn {
  flex: 1;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.op-btn:last-child {
  margin-right: 0;
}

.op-btn--warn {
  background: #FFF7E6;
  color: #AD6800;
}

.op-btn--ok {
  background: #EAF7EF;
  color: #3BB16A;
}

.op-btn--danger {
  background: #FFF1F0;
  color: #F5222D;
}

/* ===== 悬浮新增 ===== */
.fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid #EBEDF0;
}

.fab {
  height: 96rpx;
  border-radius: 48rpx;
  background: #FF7A45;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 122, 69, 0.35);
}

.fab:active {
  background: #E85F2B;
}
