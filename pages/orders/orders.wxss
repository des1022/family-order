/* ===== 顶部切换 ===== */
.seg-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #F0F1F3;
}

.seg {
  display: flex;
  background: #F2F3F5;
  border-radius: 40rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #4E5969;
  border-radius: 36rpx;
}

.seg-item--active {
  background: #fff;
  color: #FF7A45;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.08);
}

.seg-badge {
  display: inline-block;
  margin-left: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF7A45;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.tip-bar {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #FFF7E6;
  color: #AD6800;
  font-size: 26rpx;
  border-radius: 12rpx;
  line-height: 1.6;
}

.section-title {
  padding: 28rpx 32rpx 12rpx;
  font-size: 28rpx;
  color: #8A9099;
}

/* ===== 订单卡片 ===== */
.order-card {
  padding: 24rpx 32rpx;
}

.order-card--done {
  opacity: 0.55;
}

.order-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.order-nick {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}

.order-goods {
  padding: 16rpx 0;
}

.og-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.og-name {
  font-size: 30rpx;
  color: #1F2329;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.og-num {
  font-size: 30rpx;
  color: #4E5969;
  margin-left: 20rpx;
}

.order-remark {
  background: #F7F8FA;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 16rpx;
}

.order-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 2rpx solid #F5F6F7;
}

.order-time {
  font-size: 26rpx;
  color: #8A9099;
  flex: 1;
}

.order-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
}

.order-total--plain {
  font-size: 28rpx;
  font-weight: 400;
  color: #4E5969;
}

/* ===== 待做汇总 ===== */
.summary-card {
  padding: 8rpx 32rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F6F7;
}

.summary-item:last-child {
  border-bottom: none;
}

.summary-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.summary-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}

.summary-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}

.summary-from {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
}

.from-chip {
  font-size: 22rpx;
  color: #8A9099;
  background: #F2F3F5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 0 10rpx 6rpx 0;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #FF7A45;
  flex-shrink: 0;
}
